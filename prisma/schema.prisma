generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(cuid())
  firstName    String
  lastName     String
  email        String          @unique
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  passwordHash String
  assignedJobs JobAssignment[]
  vehicles     Vehicle[]
}

model Vehicle {
  id             String      @id @default(cuid())
  make           String
  model          String
  year           Int
  registrationNo String      @unique
  vin            String?     @unique
  mileage        Int?
  ownerId        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  repairJobs     RepairJob[]
  owner          User        @relation(fields: [ownerId], references: [id])
}

model RepairJob {
  id          String          @id @default(cuid())
  title       String
  description String
  status      RepairStatus    @default(PENDING)
  vehicleId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  diagnosis   Diagnosis?
  invoice     Invoice?
  assignments JobAssignment[]
  partsUsed   JobPart[]
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
}

model Diagnosis {
  id          String    @id @default(cuid())
  findings    String
  notes       String?
  repairJobId String    @unique
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model JobAssignment {
  id          String    @id @default(cuid())
  repairJobId String
  mechanicId  String
  assignedAt  DateTime  @default(now())
  mechanic    User      @relation(fields: [mechanicId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model Part {
  id       String    @id @default(cuid())
  name     String
  quantity Int
  price    Float
  jobs     JobPart[]
}

model JobPart {
  id          String    @id @default(cuid())
  repairJobId String
  partId      String
  quantity    Int
  part        Part      @relation(fields: [partId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  amount      Float
  paid        Boolean   @default(false)
  repairJobId String    @unique
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

enum Role {
  ADMIN
  MECHANIC
  CUSTOMER
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  IN_PROGRESS
  COMPLETED
  READY_FOR_PICKUP
}
